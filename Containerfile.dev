FROM docker.io/library/golang:1.27.2-trixie@sha256:47667934874913a449b96faa7ef4777fa285d9ec29126ee80ed61c45b7cccf0e AS dev
ARG SOURCE_REVISION=407bfdc12e6fdfd19c9d76d565d552ea5b39f363
ARG BUILD_CREATED=2026-10-15T00:00:00Z
LABEL org.opencontainers.image.title="Rancher Machine development" \
      org.opencontainers.image.description="Pinned Go toolchain for local and CI checks" \
      org.opencontainers.image.source="https://github.com/ioplane/rancher-machine" \
      org.opencontainers.image.revision="${SOURCE_REVISION}" \
      org.opencontainers.image.version="go1.27.2" \
      org.opencontainers.image.created="${BUILD_CREATED}" \
      org.opencontainers.image.licenses="Apache-2.0" \
      org.opencontainers.image.base.name="docker.io/library/golang:1.27.2-trixie" \
      org.opencontainers.image.base.digest="sha256:47667934874913a449b96faa7ef4777fa285d9ec29126ee80ed61c45b7cccf0e"
ENV GOFLAGS="-mod=readonly -buildvcs=false" GOTOOLCHAIN=local GOENV=off \
    GOPROXY=https://proxy.golang.org,direct GOSUMDB=sum.golang.org \
    GOCACHE=/cache/build GOMODCACHE=/cache/modules CGO_ENABLED=1
WORKDIR /src
CMD ["bash"]

FROM docker.io/golangci/golangci-lint:v2.14.0@sha256:ad862ba6b3798cbe0fd9fd7408d498fd74fbd2623a92406b2fd3898faf0bf98f AS lint-binary
FROM dev AS lint
COPY --from=lint-binary /usr/bin/golangci-lint /usr/local/bin/golangci-lint
